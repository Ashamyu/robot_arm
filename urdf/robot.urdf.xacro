<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hand_robo_arm">

  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hand_robo/meshes/Assembly 1 - basement.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="base_plate">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hand_robo/meshes/Assembly 1 - base_plate_1.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="base_plate"/>
    <origin rpy="0 0 0" xyz="-0.00003 -0.00048 0.00129"/> <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="forward_drive_arm">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hand_robo/meshes/Assembly 1 - forward_drive_arm.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="base_plate"/>
    <child link="forward_drive_arm"/>
    <origin rpy="0 0 0" xyz="0.00197 0.00335 0.00840"/> <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="horizontal_arm">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hand_robo/meshes/Assembly 1 - horizontal_arm.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="forward_drive_arm"/>
    <child link="horizontal_arm"/>
    <origin rpy="0 0 0" xyz="0.00135 -0.00375 0.00800"/> <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="claw_support">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hand_robo/meshes/Assembly 1 - claw_support.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="horizontal_arm"/>
    <child link="claw_support"/>
    <origin rpy="0 0 0" xyz="0.00167 0.01166 -0.00075"/> <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="gripper_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hand_robo/meshes/Assembly 1 - right_finger.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_gripper_right" type="prismatic">
    <parent link="claw_support"/>
    <child link="gripper_right"/>
    <origin rpy="0 0 0" xyz="-0.00141 0.00680 -0.00032"/> <axis xyz="1 0 0"/>
    <limit lower="-0.05" upper="0.05" effort="5.0" velocity="0.5"/>
  </joint>

  <link name="gripper_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://hand_robo/meshes/Assembly 1 - left_finger.stl" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_gripper_left" type="prismatic">
    <parent link="claw_support"/>
    <child link="gripper_left"/>
    <origin rpy="0 0 0" xyz="-0.00253 0.00680 -0.00032"/> <axis xyz="-1 0 0"/>
    <mimic joint="joint_gripper_right" multiplier="-1"/>
    <limit lower="-0.05" upper="0.05" effort="5.0" velocity="0.5"/>
  </joint>

</robot>
